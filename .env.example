# Copy to .env (install.sh does this for you) and fill in.

# --- You & your assistant ---
ASSISTANT_NAME=Juno
# Your first name (optional, makes it more personal)
USER_NAME=
TIMEZONE=America/New_York

# --- Model (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
# Good picks for an 8GB Orin Nano: qwen3:4b (default, best tool use), llama3.2:3b (faster), qwen3:1.7b (fastest)
MODEL=qwen3:4b
# Context window. 8192 fits comfortably in 8GB with a 4B model.
NUM_CTX=8192
# Let qwen3 "think" before answering: smarter but much slower on a Jetson.
THINK=false
# How many past chat messages the model sees each turn.
HISTORY_MESSAGES=16

# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PORT=8765
WEB_PASSWORD=
# Random string used to sign login cookies (install.sh generates one).
SECRET_KEY=

# --- Check-ins (the assistant messages you first) ---
# These are starting values; change them any time in the web app (menu > Check-in settings).
# off | light (morning brief + follow-ups) | balanced (+ evening check-in) | coach (+ midday nudge, goal check-ins)
COACH_MODE=coach
MORNING_TIME=08:00
MIDDAY_TIME=13:00
EVENING_TIME=20:30
# No check-ins during these hours (reminders you set still come through)
QUIET_HOURS=22:00-07:30
# Your city, for weather in the morning brief, e.g. Boston, MA
WEATHER_LOCATION=

# --- Web search ---
# Uses DuckDuckGo by default. For more reliable results, run your own SearxNG and put its URL here
# (see README), e.g. http://127.0.0.1:8888
SEARXNG_URL=

# --- Rebuild webhook ---
# POST /hooks/deploy with this secret pulls the latest code and restarts (install.sh generates one).
# Also used as the GitHub webhook secret. Leave empty to turn the webhook off.
DEPLOY_SECRET=
# Separate port that serves ONLY the webhook, so it can be exposed (e.g. with ngrok) without the web UI.
DEPLOY_PORT=8766

# --- Discord (optional, for chatting + reminder push notifications) ---
# See README "Discord setup".
DISCORD_TOKEN=
# Your own Discord user ID (Settings > Advanced > Developer Mode, then right-click yourself > Copy User ID)
DISCORD_OWNER_ID=
