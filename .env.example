# Copy to .env (install.sh does this for you) and fill in.

# --- You & your assistant ---
ASSISTANT_NAME=Juno
# Your first name (optional, makes it more personal)
USER_NAME=
TIMEZONE=America/New_York

# --- Model (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
# Good picks for an 8GB Orin Nano: qwen3:4b (default, best tool use), llama3.2:3b (faster), qwen3:1.7b (fastest)
MODEL=qwen3:4b
# Context window. 8192 fits comfortably in 8GB with a 4B model.
NUM_CTX=8192
# Let qwen3 "think" before answering: smarter but much slower on a Jetson.
THINK=false
# How many past chat messages the model sees each turn.
HISTORY_MESSAGES=16

# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_PASSWORD=
# Random string used to sign login cookies (install.sh generates one).
SECRET_KEY=

# --- Discord (optional, for chatting + reminder push notifications) ---
# See README "Discord setup".
DISCORD_TOKEN=
# Your own Discord user ID (Settings > Advanced > Developer Mode, then right-click yourself > Copy User ID)
DISCORD_OWNER_ID=
